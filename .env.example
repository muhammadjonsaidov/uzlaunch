# ─── Database (lokal uchun) ───────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/uzlaunch
DB_USER=uzlaunch
DB_PASSWORD=your_strong_password

# ─── Database (Railway uchun — dashboard Variables ga qo'ying) ───────────────
# DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
MAIL_FROM=UZLaunch <noreply@uzlaunch.uz>

# ─── App ─────────────────────────────────────────────────────────────────────
# Lokal:
BASE_URL=http://localhost:8080
# Railway:
# BASE_URL=https://your-app.up.railway.app

PORT=8080

# Railway orqasida nginx/proxy bo'lganda true
TRUST_PROXY=false

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_SECRET=change_this_to_a_strong_random_secret
